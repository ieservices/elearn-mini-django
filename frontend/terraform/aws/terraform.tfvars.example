# ieServices E-Learning Platform - Frontend Configuration Example
# Copy this file to terraform.tfvars and update with your values

aws_region   = "us-east-1"
project_name = "ieservices-elearn"
environment  = "dev"

# CloudFront Configuration
cloudfront_price_class = "PriceClass_100"  # Use only North America and Europe

# Backend API Configuration
backend_api_url = "http://your-backend-alb-dns-name.amazonaws.com"

# Custom Domain Configuration (optional)
# domain_name         = "example.com"
# subdomain           = "app"
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxx"

# CloudWatch Configuration
log_retention_days = 30
