# ieServices E-Learning Platform - Backend Configuration Example
# Copy this file to terraform.tfvars and update with your values

aws_region   = "us-east-1"
project_name = "ieservices-elearn"
environment  = "dev"

# VPC Configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# RDS Configuration
db_instance_class           = "db.t3.micro"
db_allocated_storage        = 20
db_max_allocated_storage    = 100
db_name                     = "elearn"
db_username                 = "elearn_admin"
db_password                 = "CHANGE_ME_SECURE_PASSWORD"
db_backup_retention_period  = 7

# ECS Configuration
ecs_task_cpu                = "256"
ecs_task_memory             = "512"
ecs_service_desired_count   = 2
ecs_autoscaling_min_capacity = 1
ecs_autoscaling_max_capacity = 10

# Application Configuration
django_secret_key = "CHANGE_ME_GENERATE_SECURE_KEY"
allowed_hosts     = "*"

# CloudWatch Configuration
log_retention_days = 30
